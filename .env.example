# ---------- Harihaat 2026 – configuration ----------
# Copy this file to .env.local and fill in the values.

# MongoDB connection (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=harihaat2026

# App password shown on the entry screen (not case-sensitive, extra spaces ignored)
APP_PASSWORD=shri ram

# Admin password: logging in (or unlocking) with it allows deleting a Shakti Peeth.
# Leave empty and nobody can delete a Shakti Peeth.
ADMIN_PASSWORD=
# Long random text used to sign the login cookie. Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Image storage: a PUBLIC GitHub repository
# Token: GitHub → Settings → Developer settings → Fine-grained token
#        → access to this one repo → Permissions: "Contents: Read and write"
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=harihaat-2026-images
GITHUB_BRANCH=main
# Folder inside the repo where images are stored
GITHUB_UPLOAD_DIR=harihaat-2026
